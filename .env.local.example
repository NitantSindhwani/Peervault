# Hardened PeerVault Environment Configuration
# Copy this file to .env.local for local testing.
# Set these variables inside Vercel Dashboard -> Environment Variables.

# Admin Telemetry Secret Key (Zero hardcoded secrets in GitHub)
ADMIN_TELEMETRY_SECRET=change_this_to_your_secure_admin_password_123

# Optional Real-Time Discord Notification Webhook URL
DISCORD_WEBHOOK_URL=
