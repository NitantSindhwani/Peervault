# Hardened PeerVault GitHub Gitignore Configuration

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Agent Skills & Private Assistant Files (CRITICAL: Excludes AI Agent Skills)
.agents/
.gemini/
.antigravity/
AGENTS.md
CLAUDE.md

# Build Outputs & Next.js Cache
/.next/
/out/
/build/
/dist/
*.tsbuildinfo
next-env.d.ts

# Testing & Playwright Artifacts
/coverage/
/test-results/
/playwright-report/
blob-report/
playwright/.cache/

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Environment Variables & Local Secrets
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.local.example

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Vercel
.vercel
